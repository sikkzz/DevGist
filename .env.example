# --- Database (Neon Postgres) ---
# 런타임용 — pooled 연결 (커넥션 고갈 방지). 호스트에 `-pooler` 포함.
# Neon 대시보드 → Connection Details → "Connection pooling" 토글 ON 후 복사
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DB?sslmode=require"
# 마이그레이션/CLI용 — direct 연결 (`-pooler` 없는 호스트). prisma migrate가 사용.
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/DB?sslmode=require"

# --- Cron 수집 인증 (ADR-0006) ---
# /api/cron/poll 호출을 인증하는 시크릿. GitHub Actions secret과 동일 값 사용.
# 생성: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET="generate-a-32-byte-hex-token"

# --- 접근 인증 게이트 (ADR-0010) ---
# 개인용 — 공개 접근 차단. 둘 다 Vercel env에도 설정.
APP_PASSWORD="set-your-password"
AUTH_TOKEN="generate-32-byte-hex: node -e \"console.log(require('crypto').randomBytes(32).toString('hex'))\""
