// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Feed {
  id            String    @id @default(cuid())
  title         String
  url           String    @unique
  siteUrl       String?
  description   String?
  category      String?
  active        Boolean   @default(true)
  lastFetchedAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  articles Article[]

  @@map("feeds")
}

model Article {
  id               String    @id @default(cuid())
  feedId           String
  guid             String
  title            String
  link             String
  author           String?
  summary          String?
  content          String?
  searchText       String? // 검색 색인용 평문(HTML/CSS 제거), FTS GIN 인덱스 대상 (ADR-0011)
  contentExtracted Boolean   @default(false)
  thumbnailUrl     String?
  topics           String[]  @default([]) // 주제 태그 (ADR-0008, 규칙 기반 멀티라벨)
  personalScore    Int       @default(0) // 개인화 관련도 점수 (ADR-0009)
  personalTags     String[]  @default([]) // 개인화 태그 (회사·학습·다양화·해볼것)
  publishedAt      DateTime?
  createdAt        DateTime  @default(now())

  feed Feed  @relation(fields: [feedId], references: [id], onDelete: Cascade)
  read Read?

  @@unique([feedId, guid])
  @@index([publishedAt])
  @@index([personalScore])
  @@map("articles")
}

model Read {
  id         String    @id @default(cuid())
  articleId  String    @unique
  isRead     Boolean   @default(false)
  bookmarked Boolean   @default(false)
  readAt     DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@map("reads")
}

// 개인화 프로필 (ADR-0009) — 단일 행. 회사 스택/학습 우선순위/다양화 키워드 셋(Json).
// 회사 정보 비공개: gitignore된 config/profile.local.json에서 seed-profile로 upsert.
model Profile {
  id        String   @id @default("default")
  data      Json
  updatedAt DateTime @updatedAt

  @@map("profile")
}

// 계정 (ADR-0010) — 회원가입 없음, 본인 1계정만 시드. DB로 관리.
model User {
  id           String    @id @default(cuid())
  username     String    @unique
  passwordHash String
  createdAt    DateTime  @default(now())

  sessions Session[]

  @@map("users")
}

// 로그인 세션 — 쿠키(sid)가 이 행의 id를 가리킴. 만료/로그아웃 시 삭제.
model Session {
  id        String   @id @default(cuid())
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}
